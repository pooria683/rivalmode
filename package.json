{
  "name": "rivalmode",
  "version": "1.0.0",
  "description": "Gamify any GitHub repo: a live scoreboard, rival tracking and a weekly roast — rendered inside your own README by Actions.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "rivalmode": "./src/cli.mjs"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "scoreboard": "node src/cli.mjs scoreboard",
    "rivals": "node src/cli.mjs rivals",
    "recap": "node src/cli.mjs recap",
    "setup": "node src/cli.mjs setup",
    "uninstall": "node src/cli.mjs uninstall",
    "test": "node --test \"tests/*.test.mjs\"",
    "demo": "node tools/make-demo-gif.mjs",
    "test:watch": "node --test --watch \"tests/*.test.mjs\""
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "gifenc": "^1.0.3"
  },
  "keywords": [
    "github",
    "readme",
    "scoreboard",
    "gamification",
    "github-actions",
    "svg",
    "developer-experience"
  ]
}
